+func TestLlamaServerScoreMedia(t *testing.T) {
+	type multimodalRequest struct {
+		Prompt struct {
+			PromptString   string   `json:"prompt_string"`
+			MultimodalData []string `json:"multimodal_data"`
+		} `json:"prompt"`
+		NPredict  int          `json:"n_predict"`
+		LogitBias [][2]float64 `json:"logit_bias"`
+	}
+	var prompts []string
+	runner := newLlamaScoreTestRunner(t, func(w http.ResponseWriter, r *http.Request) {
+		var req multimodalRequest
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			t.Errorf("media rows must send llama-server's multimodal prompt object: %v", err)
+			return
+		}
+		if req.NPredict != 1 {
+			t.Errorf("media rows must not be primed: %+v", req)
+		}
+		if !slices.Equal(req.Prompt.MultimodalData, []string{"aW1nMA==", "aW1nMQ=="}) {
+			t.Errorf("media data changed or reordered: %v", req.Prompt.MultimodalData)
+		}
+		prompts = append(prompts, req.Prompt.PromptString)
+		// The two images are embedded as 70 positions instead of their markers.
+		evaluated := len(req.Prompt.PromptString) - 2*len("<m>") + 70
+		_ = json.NewEncoder(w).Encode(scoreCompletionTestResponse(evaluated, map[int]float64{'A': 0.2, 'B': 0.8}))
+	})
+	runner.mediaMarker = "<m>"
+	runner.options.NumCtx = 200
+	media := []MediaData{{ID: 0, Data: []byte("img0")}, {ID: 1, Data: []byte("img1")}}
+	result, err := runner.Score(t.Context(), ScoreRequest{MaxTokens: 200, Media: media, Rows: []ScoreRow{
+		{Prompt: "u:[img-0][img-1]shared context, field x", Candidates: []string{"A", "B"}},
+		{Prompt: "u:[img-0][img-1]shared context, field y", Candidates: []string{"A", "B"}},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"u:<m><m>shared context, field x", "u:<m><m>shared context, field y"}; !slices.Equal(prompts, want) {
+		t.Fatalf("markers were not replaced with llama-server's: %q", prompts)
+	}
+	text := len("u:<m><m>shared context, field x")
+	if result.InputTokens != 2*(text-6+70) || result.OutputTokens != 2 {
+		t.Fatalf("usage must count embedded media positions: %+v", result)
+	}
+	if want := []float32{float32(math.Log(0.2)), float32(math.Log(0.8))}; !reflect.DeepEqual(result.Logits[1], want) {
+		t.Fatalf("scores changed: %v", result.Logits)
+	}
+
+	for _, tt := range []struct{ name, prompt string }{
+		{"missing image", "u:[img-0]x"},
+		{"repeated image", "u:[img-0][img-1][img-1]x"},
+		{"reordered images", "u:[img-1][img-0]x"},
+		{"injected marker", "u:[img-0][img-1]<m>x"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			prompts = nil
+			_, err := runner.Score(t.Context(), ScoreRequest{MaxTokens: 200, Media: media, Rows: []ScoreRow{{Prompt: tt.prompt, Candidates: []string{"A", "B"}}}})
+			if err == nil || len(prompts) != 0 {
+				t.Fatalf("a prompt that misplaces media must not be scored: err=%v prompts=%q", err, prompts)
+			}
+		})
+	}
+}
