+func TestCompileImages(t *testing.T) {
+	req := testRequest(t)
+	req.Images = []api.ImageData{[]byte("png-a"), []byte("png-b")}
+	compiled, err := Compile(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var rendered int
+	if err := compiled.Render(func(messages []api.Message) (string, error) {
+		rendered++
+		if len(messages) != 1 || len(messages[0].Images) != 2 || string(messages[0].Images[1]) != "png-b" {
+			t.Fatalf("every question must carry the request's images in order: %+v", messages)
+		}
+		return messages[0].Content, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if rendered != 3 {
+		t.Fatalf("rendered %d prompts for 3 questions", rendered)
+	}
+	text, err := Compile(testRequest(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range text.messages {
+		if text.messages[i][0].Content != compiled.messages[i][0].Content {
+			t.Fatal("images must not change the prompt text the compiler builds")
+		}
+	}
+
+	req.Images = []api.ImageData{[]byte("png-a"), {}}
+	if _, err := Compile(req); err == nil || !strings.Contains(err.Error(), "image 1") {
+		t.Fatalf("an empty image must be rejected: %v", err)
+	}
+}
