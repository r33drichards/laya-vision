+// scoreMediaPrompt replaces each media item's stable [img-N] marker with
+// llama-server's media marker. Every item must appear exactly once, in order,
+// so that llama-server pairs the markers with the right data.
+func (s *llamaServerRunner) scoreMediaPrompt(prompt string, media []MediaData) (string, error) {
+	marker := s.llamaServerMediaMarker()
+	if strings.Contains(prompt, marker) {
+		return "", errors.New("prompt contains the media marker")
+	}
+	last := -1
+	for i, m := range media {
+		if m.ID != i {
+			return "", fmt.Errorf("media %d has id %d", i, m.ID)
+		}
+		tag := fmt.Sprintf("[img-%d]", m.ID)
+		at := strings.Index(prompt, tag)
+		if at < 0 || strings.Count(prompt, tag) != 1 {
+			return "", fmt.Errorf("the rendered prompt must place image %d exactly once", m.ID)
+		}
+		if at < last {
+			return "", errors.New("the rendered prompt places images out of order")
 		}
+		last = at
+		prompt = strings.Replace(prompt, tag, marker, 1)
 	}
-	return nil, 0, fmt.Errorf("scoring candidates were outranked by other tokens")
